# dados — versionados por manifesto/hash, nunca por conteudo.
# Nota: git nao reinclui arquivo dentro de diretorio excluido, entao o padrao
# ignora os ARQUIVOS (**/*) e mantem os DIRETORIOS navegaveis (!**/).
data/raw/**/*
data/interim/**/*
data/processed/**/*
data/external/**/*
!data/**/
!data/**/.gitkeep
# Resultado versiona; dado nao (invariante 6). A convencao do projeto e que todo
# artefato de RESULTADO comeca com "_" e e JSON — entao a regra e por convencao,
# nao por lista de prefixos. A lista antiga deixou os 5 artefatos das frentes
# finais (_escore_brasil, _prediabetes, _naosupervisionada, _causal,
# _validacao_temporal) fora do repositorio sem que nada avisasse: quem clonasse
# nao conseguia reconstruir o deck nem o site, que os leem.
!data/**/_*.json
!data/**/*.md

# Pesos publicaveis: `docs/11` os chama de entregavel reutilizavel e mostra como
# carrega-los. 536 KB — versionar e o que torna a promessa verdadeira.
!data/processed/gold/pesos_arquivo_entregue.parquet

# excecao: o PDF fonte do professor e grande demais (109 MB) para o git
*.pdf
!docs/enunciado/*.pdf

# o produto e entregavel: vai para o git
!reports/produto/**

# log de execucao: e local da maquina, nao artefato do projeto
reports/execucao.jsonl

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# artefatos de modelo
models/*.pkl
models/*.joblib
mlruns/
.mlflow/

# ambiente
.env
.env.*
!.env.example

# so
Thumbs.db
.DS_Store
