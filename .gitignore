# dados — versionados por manifesto/hash, nunca por conteudo.
# Nota: git nao reinclui arquivo dentro de diretorio excluido, entao o padrao
# ignora os ARQUIVOS (**/*) e mantem os DIRETORIOS navegaveis (!**/).
data/raw/**/*
data/interim/**/*
data/processed/**/*
data/external/**/*
!data/**/
!data/**/.gitkeep
!data/**/_manifest_*.json
!data/**/_relatorio_*.json
!data/**/_cascata_*.json
!data/**/_analise_*.json
!data/**/_eda_*.json
!data/**/_modelo_*.json
!data/**/_escada_*.json
!data/**/_comparacao_*.json
!data/**/_frente*.json
!data/**/_trilhaC_*.json
!data/**/_features_*.json
!data/**/*.md

# excecao: o PDF fonte do professor e grande demais (109 MB) para o git
*.pdf
!docs/enunciado/*.pdf

# o produto e entregavel: vai para o git
!reports/produto/**

# log de execucao: e local da maquina, nao artefato do projeto
reports/execucao.jsonl

# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# artefatos de modelo
models/*.pkl
models/*.joblib
mlruns/
.mlflow/

# ambiente
.env
.env.*
!.env.example

# so
Thumbs.db
.DS_Store
